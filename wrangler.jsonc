// Cloudflare Workers – static site deploy of the game (no build step)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "havocrally",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true
}
